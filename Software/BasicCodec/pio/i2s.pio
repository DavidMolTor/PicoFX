.program mclk

; Generate MCLK in a single pin SET
; State machine must run at 2 * F_MCLK

.wrap_target
    set pins, 1
    set pins, 0
.wrap


.program i2s_tx
.side_set 2

; Sideset bits: LRCK = 0, SCLK = 1
; I2S standard: LRCK = 0 -> LEFT, LRCK = 1 -> RIGHT

public entry_point:
    pull noblock            side 0b01   ; Get a word from the queue, LRCK = HIGH, SCKL = LOW
    set x, 30               side 0b11   ; Load the register counter, LRCK = HIGH, SCKL = HIGH

left_loop:
    out pins, 1             side 0b01   ; Start sending data, LRCK = HIGH, SCKL = LOW
    jmp x-- left_loop       side 0b11   ; Decrease the count, LRCK = HIGH, SCKL = HIGH

    pull noblock            side 0b00   ; Get a word from the queue, LRCK = LOW, SCKL = LOW
    set x, 30               side 0b10   ; Load the register counter, LRCK = LOW, SCKL = HIGH

right_loop:
    out pins, 1             side 0b00   ; Start sending data, LRCK = LOW, SCKL = LOW
    jmp x-- right_loop      side 0b10   ; Decrease the count, LRCK = LOW, SCKL = HIGH


.program i2s_rx

; Sideset bits: LRCK = 0, SCLK = 1
; I2S standard: LRCK = 0 -> LEFT, LRCK = 1 -> RIGHT

public entry_point:
    set x, 23               ; Set the 24-bit word length counter
    wait 1 jmppin [2]       ; LRCK falling edge for left channel

left_loop:
    in pins, 1              ; Sample DIN at half window
    jmp x-- left_loop       ; Decrease the counter and iterate

    push noblock            ; Push the sample to the RX queue

    set x, 23               ; Set the 24-bit word length counter
    wait 0 jmppin [2]       ; LRCK rising edge for right channel

right_loop:
    in pins, 1              ; Sample DIN at half window
    jmp x-- right_loop      ; Decrease the counter and iterate

    push noblock            ; Push the sample to the RX queue


% c-sdk {

static inline void mclk_program_init(PIO pio, uint sm, uint offset, uint pin_mclk, float div)
{
    pio_gpio_init(pio, pin_mclk);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_mclk, 1, true);

    pio_sm_config c = mclk_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin_mclk, 1);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
}

static inline void i2s_tx_program_init(PIO pio, uint sm, uint offset,
                                       uint pin_sdout, uint pin_lrck_base, float div)
{
    pio_gpio_init(pio, pin_sdout);
    pio_gpio_init(pio, pin_lrck_base + 0);
    pio_gpio_init(pio, pin_lrck_base + 1);

    pio_sm_set_consecutive_pindirs(pio, sm, pin_sdout, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, pin_lrck_base, 2, true);

    pio_sm_config sm_config = i2s_tx_program_get_default_config(offset);

    sm_config_set_out_pins(&sm_config, pin_sdout, 1);
    sm_config_set_sideset_pins(&sm_config, pin_lrck_base);

    sm_config_set_out_shift(&sm_config, false, true, 32);
    sm_config_set_fifo_join(&sm_config, PIO_FIFO_JOIN_TX);
    sm_config_set_clkdiv(&sm_config, div);

    pio_sm_init(pio, sm, offset, &sm_config);
}

static inline void i2s_rx_program_init(PIO pio, uint sm, uint offset,
                                       uint pin_sdin, uint pin_lrck_base, float div)
{
    pio_gpio_init(pio, pin_sdin);

    pio_sm_config sm_config = i2s_rx_program_get_default_config(offset);

    sm_config_set_jmp_pin(&sm_config, pin_lrck_base);
    sm_config_set_in_pins(&sm_config, pin_sdin);

    sm_config_set_in_shift(&sm_config, false, true, 32);
    sm_config_set_fifo_join(&sm_config, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&sm_config, div);

    pio_sm_init(pio, sm, offset, &sm_config);
}

%}